  {
    "id": "jul_aug_change",
    "question": "How much did merchandise value change from July to August 2018?",
    "sql": "SELECT ROUND(SUM(CASE WHEN o.order_purchase_timestamp >= '2018-08-01' THEN i.price ELSE -i.price END),2) AS delta_brl FROM order_items i JOIN orders o ON i.order_id=o.order_id WHERE o.order_purchase_timestamp >= '2018-07-01' AND o.order_purchase_timestamp < '2018-09-01'",
